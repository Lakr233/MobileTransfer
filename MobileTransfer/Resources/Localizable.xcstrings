      }
    },
    "The backup manifest created by %@ will be modified to match the current device system version %@ (%@). This may cause issues during restore. Please proceed with caution." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The backup manifest created by %1$@ will be modified to match the current device system version %2$@ (%3$@). This may cause issues during restore. Please proceed with caution."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此备份的元数据由 %1$@ 创建。将会使用 %2$@ (%3$@) 覆盖填充。这可能会使此备份在恢复过程中出现未知错误。请谨慎操作。"
          }
        }
      }
    },
    "The backup manifest has been modified successfully." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此备份的元数据已修改成功。"
          }
        }
      }
    },
    "The backup was created on a newer version of iOS. Please update the device to the latest version before restoring." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
