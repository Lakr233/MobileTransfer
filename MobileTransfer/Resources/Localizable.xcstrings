        }
      }
    },
    "This device has %lld apps installed, %lld of them is unable to get account information, will use first eligible account to download." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This device has %1$lld apps installed, %2$lld of them is unable to get account information, will use first eligible account to download."
          }
