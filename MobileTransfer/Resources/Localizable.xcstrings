        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备装有 %1$lld 个软件，其中 %2$lld 个软件不包含账号信息，将会使用首个可用账户下载。"
          }
        }
      }
    },
    "This device has a backup password set, you will need the password to use this backup." : {
