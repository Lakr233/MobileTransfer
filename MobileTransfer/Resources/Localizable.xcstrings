    },
    "The selected archive looks validate." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选定的归档似乎是完好的。"
          }
        }
      }
    },
    "The unfinished incremental version will continue from its previous complete snapshot." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未完成的增量备份版本将从上一个完整快照继续。"
          }
        }
      }
    },
    "There are two types of restore modes, **Merge Restore** and **Replace Restore**." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此程序提供两种恢复模式：**合并恢复** 和 **替换恢复** 。"
          }
        }
      }
    },
    "Therefor, we suggest you to choose **Merge Restore**." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因此，我们推荐你选择 **合并恢复**。"
          }
        }
      }
    },
    "This backup belongs to another device." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此备份属于另一台设备。"
          }
        }
      }
    },
    "This backup cannot be continued." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法继续此备份。"
          }
        }
      }
    },
    "This backup does not include any apps, we suggest you to choose **Replace Restore**." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此备份不包含软件安装包，因此我们推荐使用 **替换恢复**。"
          }
        }
      }
    },
    "This backup has no verified incremental checkpoint. Retrying may transfer all device data again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此备份没有经过验证的增量检查点。重试可能需要重新传输设备的全部数据。"
          }
        }
      }
    },
    "This backup includes %lld apps, which can not be installed if using Replace Restore." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此备份包含 %lld 个软件安装包。这些软件不能在使用替换恢复时安装。"
          }
        }
      }
    },
