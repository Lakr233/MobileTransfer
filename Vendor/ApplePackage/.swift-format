{
  "version": 1,
  "indentation": {
    "spaces": 4
  },
  "lineLength": 140,
  "respectsExistingLineBreaks": true,
  "spacesAroundRangeFormationOperators": true,
  "rules": {
    "GroupNumericLiterals": false,
    "NoBlockComments": false,
    "AlwaysUseLowerCamelCase": false
  },
  "lineBreakBetweenDeclarationAttributes": true
}
